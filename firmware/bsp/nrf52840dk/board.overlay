/* nRF52840 DK pin map. Keep device id order aligned with bsp.h.
 * ECU UART1 uses P1.02/P1.01 through a car-side level shifter.
 * UART0 remains the console. Buttons use P0.11/P0.12.
 * Display SPI2 uses P0.19/P0.20/P0.21; CS/DC/RESET use P0.22/P0.23/P0.24.
 * The display driver controls CS and reset polarity. */

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>;
			bias-pull-up;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RX, 1, 1)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <9600>; /* the HAL sets the real rate */
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

/* The DK's on-board QSPI flash is wired to P0.17 and P0.19 to P0.23, the pins
 * the display uses below. Nothing here uses it, and the production module (a
 * Raytac MDBT50Q) has no external flash, so the driver stays off. */
&qspi {
	status = "disabled";
};

/* A child node stays enabled on its own when only its bus is disabled, and
 * the flash driver is built for every enabled chip node, so the chip too. */
&mx25r64 {
	status = "disabled";
};

/* The DK's own dts makes spi2 the older SPI peripheral, which has no DMA and
 * interrupts for every byte: a full face took over two seconds to send.
 * SPIM moves the bytes by DMA. */
&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	zephyr,user {
		hal-gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpio0 22 GPIO_ACTIVE_HIGH>,
			    <&gpio0 23 GPIO_ACTIVE_HIGH>,
			    <&gpio0 24 GPIO_ACTIVE_HIGH>,
			    <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		hal-uarts = <&uart1>;
		hal-spis = <&spi2>;
	};
};
