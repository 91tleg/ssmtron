/* nRF52840 DK. Keep the id order in step with bsp.h.
 *
 * ECU UART on UART1: TX P1.02, RX P1.01 (3.3 V here; the car side needs the
 * level shifter). Button 1 on P0.11. UART0 stays the DK's console.
 *
 * Display SPI on SPI2 (the DK's default pins for it): SCK P0.19,
 * MOSI P0.20, MISO P0.21 (unused by a write-only panel, but the pinctrl
 * group needs it claimed). Display control lines are ordinary GPIOs,
 * P0.22 (CS), P0.23 (DC), P0.24 (RESET); no backlight control (tied on).
 * None of P0.19-24 are used elsewhere on this board. Plain (active-high)
 * polarity throughout: gc9a01.c encodes CS/reset polarity itself rather
 * than relying on a devicetree flag. */

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 1)>;
			bias-pull-up;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RX, 1, 1)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <9600>; /* the HAL sets the real rate */
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	zephyr,user {
		hal-gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpio0 22 GPIO_ACTIVE_HIGH>,
			    <&gpio0 23 GPIO_ACTIVE_HIGH>,
			    <&gpio0 24 GPIO_ACTIVE_HIGH>;
		hal-uarts = <&uart1>;
		hal-spis = <&spi2>;
	};
};
